  "license": "MIT",
  "homepage": "https://gmtigrisva123.github.io/Blooom-Project/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmtigrisva123/Blooom-Project.git"
  },
  "bugs": {
    "url": "https://github.com/gmtigrisva123/Blooom-Project/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
