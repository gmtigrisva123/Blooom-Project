{
  "name": "studyhub",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Nền tảng nhóm học tập tương tác cho học sinh & sinh viên — nhóm học theo môn, Pomodoro, theo dõi hiệu suất và kho ghi chú số hóa.",
  "keywords": [
    "react",
    "vite",
    "pomodoro",
    "study-groups",
    "education",
    "vietnamese"
  ],
