{
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "none",
  "printWidth": 96,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "*.md",
      "options": { "printWidth": 100, "proseWrap": "preserve" }
    },
    {
      "files": "*.{yml,yaml}",
      "options": { "singleQuote": true }
    }
  ]
}
