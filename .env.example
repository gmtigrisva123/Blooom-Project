# ===========================================================================
# BLOOOM — BIẾN MÔI TRƯỜNG
#
# Chép tệp này thành `.env` rồi điền giá trị của dự án Supabase của bạn:
#
#     cp .env.example .env
#
# Vite chỉ đọc `.env` lúc khởi động, nên sau khi sửa phải chạy lại
# `npm run dev`.
# ===========================================================================

# Địa chỉ dự án Supabase. Lấy ở Project Settings › API › Project URL.
VITE_SUPABASE_URL="https://yourvitesupabaseurlhere.supabase.co"

# Khóa "anon public". Lấy ở Project Settings › API › Project API keys.
#
# Khóa này là khóa CÔNG KHAI theo thiết kế của Supabase: nó chỉ định danh dự
# án, còn quyền đọc/ghi từng hàng do Row Level Security quyết định (xem
# supabase/migrations/0001_init.sql). Vì vậy nó nằm trong bundle phía trình
# duyệt là bình thường.
#
# TUYỆT ĐỐI KHÔNG đặt khóa `service_role` vào đây. Khóa đó bỏ qua toàn bộ Row
# Level Security, và mọi biến bắt đầu bằng VITE_ đều được nhúng thẳng vào mã
# JavaScript gửi tới trình duyệt — đặt nó vào đây là công khai quyền quản trị
# cơ sở dữ liệu cho bất kỳ ai mở DevTools.
VITE_SUPABASE_ANON_KEY=youranonkeyhere
